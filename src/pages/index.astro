---
import BaseLayout from "../layouts/BaseLayout.astro";
import ThemeToggle from "../components/ThemeToggle.astro";

export const prerender = false;

const theme = Astro.cookies.get("theme")?.value ?? "light";
---

<BaseLayout pageTitle="Laboratorio SSR">
  <h1>Laboratorio de Cookies + SSR</h1>

  <p>
    Tema actual:
    <strong>{theme}</strong>
  </p>

  <ThemeToggle />

  <hr />

  <p>
    <a href="/login">
      Ir al login
    </a>
  </p>

  <p>
    <a href="/dashboard">
      Ir al dashboard
    </a>
  </p>
</BaseLayout>
