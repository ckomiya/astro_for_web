---
import AddToCartButton from '../components/AddToCartButton.jsx';
import CartCounter from '../components/CartCounter.vue';

const product = {
  id: 1,
  name: 'Zapatillas',
  price: 120
};
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>Nano Stores Demo</title>
  </head>

  <body>
    <header>
      <h1>Mi tienda</h1>

      <!-- Island Vue -->
      <CartCounter client:load />
    </header>

    <main>
      <h2>{product.name}</h2>

      <p>Precio: S/ {product.price}</p>

      <!-- Island React -->
      <AddToCartButton
        client:load
        product={product}
      />
    </main>
  </body>
</html>