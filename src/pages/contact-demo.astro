<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>Contacto</title>
  </head>

  <body>
    <h1>Formulario de contacto</h1>

    <form method="POST" action="/api/feedback">
      <div>
        <label for="email">
          Email:
        </label>

        <input
          id="email"
          name="email"
          type="email"
          required
        />
      </div>

      <div>
        <label for="message">
          Mensaje:
        </label>

        <textarea
          id="message"
          name="message"
          required
        ></textarea>
      </div>

      <button type="submit">
        Enviar
      </button>
    </form>
  </body>
</html>