---
interface Props {
  year: number;
  data: number[];
}

const { year, data } = Astro.props;

const maxValue = Math.max(...data);
---

<div class="chart">

  <h2>Ventas {year}</h2>

  <div class="bars">

    {
      data.map((value, index) => {
        const height = (value / maxValue) * 200;

        return (
          <div class="bar-container">

            <div
              class="bar"
              style={`height: ${height}px`}
            ></div>

            <span>Q{index + 1}</span>

            <small>{value}</small>

          </div>
        );
      })
    }

  </div>

</div>

<style>
  .chart {
    padding: 25px;
    margin: 30px 0;
    background: #f5f5f5;
    border-radius: 10px;
  }

  .bars {
    display: flex;
    align-items: end;
    gap: 20px;
    height: 240px;
    padding-top: 20px;
  }

  .bar-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: end;
    gap: 5px;
  }

  .bar {
    width: 50px;
    background: #555;
    border-radius: 5px 5px 0 0;
  }

  small {
    color: #666;
  }
</style>