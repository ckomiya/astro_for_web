---
interface Props {
  type?: "success" | "warning" | "error";
}

const { type = "success" } = Astro.props;
---

<div class={`alert ${type}`}>
  <strong>
    {
      type === "success"
        ? "Éxito"
        : type === "warning"
          ? "Advertencia"
          : "Error"
    }
  </strong>

  <div>
    <slot />
  </div>
</div>

<style>
  .alert {
    padding: 15px 20px;
    margin: 25px 0;
    border-radius: 8px;
  }

  .success {
    background: #e8f5e9;
    border: 1px solid #4caf50;
  }

  .warning {
    background: #fff8e1;
    border: 1px solid #ff9800;
  }

  .error {
    background: #ffebee;
    border: 1px solid #f44336;
  }
</style>