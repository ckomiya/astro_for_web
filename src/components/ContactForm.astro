<form
  class="contact-form"
  method="POST"
  action="/api/contact"
>
  <label for="email">Correo electrónico</label>

  <input
    id="email"
    name="email"
    type="email"
    required
    placeholder="tu@email.com"
  />

  <button type="submit">
    Enviar
  </button>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>(".contact-form");

  if (form) {
    form.addEventListener("submit", (event) => {
      event.preventDefault();

      const formData = new FormData(form);
      const email = formData.get("email");

      console.log("Email:", email);

      alert(`Formulario preparado para: ${email}`);
    });
  }
</script>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 400px;
  }

  input {
    padding: 0.6rem;
  }

  button {
    padding: 0.6rem;
    cursor: pointer;
  }
</style>